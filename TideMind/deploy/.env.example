# Synthetic/offline configuration. No QQ credentials, no production paths.
TIDEMIND_AGENT_ID=xiyu
TIDEMIND_MODE=shadow
TIDEMIND_HOME=local
TIDEMIND_DATA_DIR=/data/xiyu
TIDEMIND_BACKUP_DIR=/data/backups/xiyu
TIDEMIND_SYNC_DIRECTION=local-to-cloud
TIDEMIND_L3_ENABLED=false
TIDEMIND_PULSE_REST=true
TIDEMIND_BUDGET_UNITS=100
# Entries are not enabled until their actual configuration interfaces are reviewed.
# Future authority configuration. Original lease.mjs is the only lease entry.
# These MUST NOT point to any existing production/shadow directory.
TIDEMIND_SANDBOX_ROOT=/data/test
TIDEMIND_LEASE_DB=/data/test/lease.db
TIDEMIND_AUTHORITY_PORT=5181
# Distinct credentials injected locally; never copy QQ credentials to clients.
TIDEMIND_LOCAL_TOKEN=
TIDEMIND_CLOUD_TOKEN=
# Must be obtained from the protected baseline before activation; no default.
TIDEMIND_PROTECTED_IDS=
TIDEMIND_BASELINE_DATA_HASH=
TIDEMIND_BASELINE_PROTECTED_HASH=
# Required for upgraded authority; blank means fail closed.
TIDEMIND_REQUIRE_STORE_PROOF=1
TIDEMIND_STORE_SIGNING_KEY=
# Never enable this compatibility-test switch in a deployed service.
TIDEMIND_ALLOW_LEGACY_SYNTHETIC=0

TIDEMIND_REQUIRE_QQ_BINDING=1

# Isolated Hub source copies only; not a production installation instruction.
# All paths must remain beneath the synthetic root.
TIDEMIND_AURABOT_MEMORY_DB=/data/test/local/memory.db
TIDEMIND_AURABOT_DATA_ROOT=/data/test/aurabot-data
TIDEMIND_AURABOT_HOME=/data/test/aurabot-home
TIDEMIND_AURABOT_WORKSPACE=/data/test/workspace
TIDEMIND_SELF_NOTES_DIR=/data/test/self-notes
